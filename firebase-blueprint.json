{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account information.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "mobile": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "sales_manager", "inventory_manager", "ca"] },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["role"]
    },
    "Profile": {
      "title": "Profile",
      "description": "Business profile for invoice generation.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessName": { "type": "string" },
        "ownerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "gstin": { "type": "string" },
        "state": { "type": "string" },
        "logo": { "type": "string" },
        "signatureUrl": { "type": "string" },
        "taxPercentage": { "type": "number" },
        "trackInventory": { "type": "boolean" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "invoiceTheme": { "type": "string" }
      },
      "required": ["userId", "businessName"]
    },
    "BusinessProfile": {
      "title": "BusinessProfile",
      "description": "Public business profile for B2B discovery.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "businessName": { "type": "string" },
        "ownerName": { "type": "string" },
        "mobile": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "gstNumber": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "logoUrl": { "type": "string" },
        "pricingType": { "type": "string", "enum": ["show", "hide"] },
        "moq": { "type": "number" },
        "deliveryType": { "type": "string", "enum": ["pickup", "local", "courier"] },
        "verificationLevel": { "type": "string", "enum": ["basic", "gst_verified", "premium"] },
        "rating": { "type": "number" },
        "totalRatings": { "type": "number" }
      },
      "required": ["userId", "businessName", "mobile", "categories"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory or B2B product.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["product", "service"] },
        "sku": { "type": "string" },
        "hsnCode": { "type": "string" },
        "gstRate": { "type": "number" },
        "costPrice": { "type": "number" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "primaryUnit": { "type": "string" },
        "category": { "type": "string" },
        "trackInventory": { "type": "boolean" },
        "isPublic": { "type": "boolean" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["userId", "name", "price"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Invoice or quotation record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "date": { "type": "number" },
        "total": { "type": "number" },
        "receivedAmount": { "type": "number" },
        "type": { "type": "string", "enum": ["invoice", "quotation"] },
        "paymentMethod": { "type": "string", "enum": ["cash", "card", "upi", "other", "split"] },
        "splitPayments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": { "type": "string", "enum": ["cash", "card", "upi", "other"] },
              "amount": { "type": "number" }
            }
          }
        }
      },
      "required": ["userId", "invoiceNumber", "customerName", "total"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "number" },
        "method": { "type": "string" }
      },
      "required": ["userId", "customerName", "amount", "date"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Business expense record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "number" },
        "description": { "type": "string" }
      },
      "required": ["userId", "category", "amount", "date"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Staff member record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["userId", "name", "role", "status"]
    },
    "Connection": {
      "title": "Connection",
      "description": "B2B connection between businesses.",
      "type": "object",
      "properties": {
        "fromUserId": { "type": "string" },
        "toUserId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "connected", "rejected"] }
      },
      "required": ["fromUserId", "toUserId", "status"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "B2B inquiry records.",
      "type": "object",
      "properties": {
        "buyerId": { "type": "string" },
        "sellerId": { "type": "string" },
        "productId": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "viewed", "responded", "closed"] }
      },
      "required": ["buyerId", "sellerId", "productId", "status"]
    },
    "B2BOrder": {
      "title": "B2BOrder",
      "description": "B2B order records.",
      "type": "object",
      "properties": {
        "buyerId": { "type": "string" },
        "sellerId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "delivered", "cancelled"] },
        "totalAmount": { "type": "number" }
      },
      "required": ["buyerId", "sellerId", "status", "totalAmount"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "isRead": { "type": "boolean" },
        "type": { "type": "string" }
      },
      "required": ["userId", "title", "message", "isRead"]
    },
    "Review": {
      "title": "Review",
      "description": "Seller reviews.",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "buyerId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" }
      },
      "required": ["sellerId", "buyerId", "rating"]
    },
    "PopularSearch": {
      "title": "PopularSearch",
      "description": "Popular search queries.",
      "type": "object",
      "properties": {
        "query": { "type": "string" },
        "count": { "type": "number" }
      },
      "required": ["query", "count"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Staff activity and transaction log.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "type": { "type": "string", "enum": ["stock", "invoice", "payment", "expense", "security", "other"] },
        "timestamp": { "type": "number" }
      },
      "required": ["userId", "staffId", "staffName", "action", "type", "timestamp"]
    }
  },
  "firestore": {
    "users": { "schema": "User", "description": "User accounts" },
    "profiles": { "schema": "Profile", "description": "Business settings" },
    "business_profiles": { "schema": "BusinessProfile", "description": "Public business profiles" },
    "products": { "schema": "Product", "description": "Inventory products" },
    "b2b_products": { "schema": "Product", "description": "Wholesale products" },
    "invoices": { "schema": "Invoice", "description": "Sales invoices" },
    "quotations": { "schema": "Invoice", "description": "Quotes" },
    "payments": { "schema": "Payment", "description": "Payment records" },
    "expenses": { "schema": "Expense", "description": "Business expenses" },
    "staff": { "schema": "Staff", "description": "Staff members" },
    "activities": { "schema": "Activity", "description": "Audit logs" },
    "connections": { "schema": "Connection", "description": "B2B connections" },
    "inquiries": { "schema": "Inquiry", "description": "B2B inquiries" },
    "b2b_orders": { "schema": "B2BOrder", "description": "Wholesale orders" },
    "notifications": { "schema": "Notification", "description": "User notifications" },
    "reviews": { "schema": "Review", "description": "Seller reviews" },
    "popular_searches": { "schema": "PopularSearch", "description": "Search analytics" },
    "userSessions": { "schema": { "type": "object", "properties": { "userId": { "type": "string" } } }, "description": "User login sessions" }
  }
}

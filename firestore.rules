rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "ry9506602867@gmail.com" && request.auth.token.get('email_verified', false) == true)
      );
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {'role': 'guest', 'ownerId': ''};
    }

    function hasRole(role) {
      let data = getUserData();
      return isSignedIn() && data.get('role', '') == role;
    }

    function isStaffOf(ownerId) {
      let data = getUserData();
      return isSignedIn() && (data.get('ownerId', '') == ownerId || request.auth.uid == ownerId);
    }

    function canAccess(ownerId) {
      return isOwner(ownerId) || isStaffOf(ownerId) || isAdmin();
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
    }

    match /business_profiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isOwner(userId);
    }

    match /products/{productId} {
      allow get: if isSignedIn() && canAccess(resource.data.userId);
      allow list: if isSignedIn() && (canAccess(resource.data.userId) || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && canAccess(incoming().userId);
      allow update: if isSignedIn() && canAccess(existing().userId);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    match /b2b_products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow update: if isSignedIn() && isOwner(existing().userId);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    match /invoices/{invoiceId} {
      allow get: if isSignedIn() && (canAccess(resource.data.userId) || hasRole('ca'));
      allow list: if isSignedIn() && (canAccess(resource.data.userId) || hasRole('ca'));
      allow create: if isSignedIn() && canAccess(incoming().userId);
      allow update: if isSignedIn() && canAccess(existing().userId);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    match /quotations/{invoiceId} {
      allow get: if isSignedIn() && (canAccess(resource.data.userId) || hasRole('ca'));
      allow list: if isSignedIn() && (canAccess(resource.data.userId) || hasRole('ca'));
      allow create: if isSignedIn() && canAccess(incoming().userId);
      allow update: if isSignedIn() && canAccess(existing().userId);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    match /payments/{paymentId} {
      allow get: if isSignedIn() && (canAccess(resource.data.userId) || hasRole('ca'));
      allow list: if isSignedIn() && (canAccess(resource.data.userId) || hasRole('ca'));
      allow create: if isSignedIn() && canAccess(incoming().userId);
      allow update: if isSignedIn() && canAccess(existing().userId);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    match /expenses/{expenseId} {
      allow get: if isSignedIn() && (canAccess(resource.data.userId) || hasRole('ca'));
      allow list: if isSignedIn() && (canAccess(resource.data.userId) || hasRole('ca'));
      allow create: if isSignedIn() && canAccess(incoming().userId);
      allow update: if isSignedIn() && canAccess(existing().userId);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    match /staff/{staffId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow update: if isSignedIn() && isOwner(existing().userId);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    match /connections/{connectionId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);
      allow create: if isSignedIn() && (request.auth.uid == incoming().fromUserId || request.auth.uid == incoming().toUserId);
      allow update: if isSignedIn() && (request.auth.uid == existing().fromUserId || request.auth.uid == existing().toUserId);
    }

    match /inquiries/{inquiryId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow create: if isSignedIn() && (request.auth.uid == incoming().buyerId || request.auth.uid == incoming().sellerId);
      allow update: if isSignedIn() && (request.auth.uid == existing().buyerId || request.auth.uid == existing().sellerId);
    }

    match /b2b_orders/{orderId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow create: if isSignedIn() && (request.auth.uid == incoming().buyerId || request.auth.uid == incoming().sellerId);
      allow update: if isSignedIn() && (request.auth.uid == existing().buyerId || request.auth.uid == existing().sellerId);
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn(); // System or other users can send
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(incoming().buyerId);
      allow update: if isSignedIn() && isOwner(existing().buyerId);
      allow delete: if isSignedIn() && isOwner(resource.data.buyerId);
    }

    match /popular_searches/{searchId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    match /userSessions/{sessionId} {
      allow read: if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }
    
    match /test/{docId} {
      allow read: if true;
    }
  }
}
